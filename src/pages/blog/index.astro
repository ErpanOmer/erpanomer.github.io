---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import { getCatalog } from '@/lib/blog-catalog';
import { CatalogInputError, parseCatalogOptions, type CatalogPage } from '@/lib/public-posts';
import { renderPostCard } from '@/lib/post-card';

let options;
let page: CatalogPage = { items: [], nextCursor: null, hasMore: false, source: 'combined' };
let error = '';
try {
    options = { ...parseCatalogOptions(Astro.url.searchParams), includeMeta: true };
    page = await getCatalog(Astro.locals.runtime?.env?.BLOG_DB, options);
} catch (err) {
    Astro.response.status = err instanceof CatalogInputError ? 400 : 503;
    error = err instanceof CatalogInputError ? err.message : '文章暂时加载失败，请稍后重试。';
    if (!(err instanceof CatalogInputError)) console.error('Blog page query failed:', err);
}
options ??= { q: '', tag: '', sort: 'latest' as const, includeMeta: true };
const meta = page.meta;
const count = (value: number | null | undefined) => value == null ? '—' : new Intl.NumberFormat('zh-CN').format(value);
const nextParams = new URLSearchParams(Astro.url.searchParams);
nextParams.delete('includeMeta');
if (page.nextCursor) nextParams.set('cursor',page.nextCursor);
const initial = JSON.stringify({ page, options, error }).replace(/</g,'\\u003c');
---
<BaseLayout title="文章 · 前端技术官" description="ErpanOmer 的前端工程、AI 开发与职业思考。按标签探索文章，搜索你的下一个答案。">
    <div class="site-container blog-shell" id="blog-app">
        <PageIntro eyebrow="ERPANOMER / WRITING" title="文章与思考。" description="关于前端工程、AI 开发与职业成长。记录实践、判断，以及还在探索的问题。" />
        <dl class="catalog-stats" aria-label="本站文章统计">
            <div><dt>本站文章</dt><dd data-stat="total">{count(meta?.total)}</dd></div>
            <div><dt>累计阅读</dt><dd data-stat="views">{count(meta?.views)}</dd></div>
            <div><dt>收获点赞</dt><dd data-stat="likes">{count(meta?.likes)}</dd></div>
            <div><dt>内容标签</dt><dd data-stat="tagCount">{count(meta?.tagCount)}</dd></div>
        </dl>
        <div class="catalog-workspace">
            <aside class="tag-sidebar" aria-label="文章标签">
                <div class="sidebar-heading"><h2>按兴趣探索</h2><span>TAGS</span></div>
                <div id="tag-list" class="catalog-tags">
                    <a href="/blog" class:list={['catalog-tag', { active: !options.tag }]} data-tag="">全部文章 <span>{count(meta?.total)}</span></a>
                    {meta?.tags.map((tag,index)=><a href={`/blog?tag=${encodeURIComponent(tag.name)}`} class:list={['catalog-tag', {active:options.tag===tag.name, 'extra-tag':index>=12}]} data-tag={tag.name} aria-current={options.tag===tag.name?'true':undefined}>{tag.name}<span>{tag.count}</span></a>)}
                </div>
                <button type="button" class="text-action tag-expand" id="expand-tags" aria-expanded="false" hidden={(meta?.tags.length || 0)<=12}>展开全部标签</button>
                <p class="sidebar-note">每一篇文章，都是一次思考的存档。</p>
                <a class="text-action" href="/rss.xml" target="_blank">通过 RSS 订阅 ↗</a>
            </aside>
            <section class="catalog-main" aria-label="文章列表">
                <form class="catalog-toolbar" id="catalog-form" action="/blog" method="get" role="search">
                    <label class="search-field"><span class="sr-only">搜索文章</span><span aria-hidden="true">⌕</span><input type="search" name="q" id="post-search" placeholder="搜索标题、摘要或标签…" value={options.q} maxlength="100" autocomplete="off" /></label>
                    <input type="hidden" name="tag" id="selected-tag" value={options.tag} />
                    <label class="sort-field"><span class="sr-only">文章排序</span><select name="sort" id="post-sort"><option value="latest" selected={options.sort==='latest'}>最新发布</option><option value="views" selected={options.sort==='views'}>最多阅读</option><option value="likes" selected={options.sort==='likes'}>最多点赞</option></select></label>
                    <button class="button-secondary search-submit" type="submit">搜索</button>
                </form>
                <div class="catalog-result-heading"><p id="result-count">{options.tag ? `${options.tag} · ` : ''}{meta ? `${meta.matchingTotal} 篇文章` : '文章列表'}</p><a href="/blog" id="reset-filters" class="text-action" hidden={!options.q&&!options.tag&&options.sort==='latest'}>重置筛选</a></div>
                <p class="catalog-notice" id="catalog-notice" hidden={page.source!=='static'}>当前展示本地静态文章，阅读与点赞统计暂不可用。</p>
                <p id="catalog-error" class="catalog-error" role="alert" hidden={!error}>{error} <a href="/blog">重新加载列表</a></p>
                <div id="post-list" class="post-list" aria-busy="false">{page.items.map(post=><Fragment set:html={renderPostCard(post)} />)}</div>
                <div class="catalog-empty" id="catalog-empty" hidden={!!page.items.length||!!error}><h2>没有找到相关文章</h2><p>试试其他关键词，或换一个感兴趣的标签。</p><a class="text-action" href="/blog">查看全部文章 →</a></div>
                <div class="load-zone" id="load-zone"><a class="button-secondary load-more" id="load-more" href={`?${nextParams}`} hidden={!page.hasMore}>加载更多文章</a><p id="load-status" role="status" aria-live="polite">{!page.hasMore&&page.items.length?'已经读到这里的全部文章了。':''}</p><div id="load-sentinel" aria-hidden="true"></div></div>
            </section>
        </div>
    </div>
    <script type="application/json" id="catalog-initial" set:html={initial} />
    <script>
        import '@/scripts/blog-list';
    </script>
</BaseLayout>
