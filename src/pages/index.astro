---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Achievements from '@/components/Achievements.astro';
import Projects from '@/components/Projects.astro';
import LatestPosts from '@/components/LatestPosts.astro';
import { fetchSocialStats } from '@/lib/social-stats';
import { getCatalog, catalogCacheContext } from '@/lib/blog-catalog';

const env = Astro.locals.runtime?.env;
const catalogCache = catalogCacheContext(Astro.url);
const [socialStats, latestResult, popularResult] = await Promise.all([
    fetchSocialStats({ transport: import.meta.env.PROD ? 'service' : 'public', serviceBinding: import.meta.env.PROD ? env?.GET_FANS_WORKER : null }),
    getCatalog(env?.BLOG_DB, { q:'',tag:'',sort:'latest',includeMeta:true }, 6, catalogCache).catch(error=>{console.error('Homepage latest posts:',error);return null;}),
    getCatalog(env?.BLOG_DB, { q:'',tag:'',sort:'views',includeMeta:false }, 9, catalogCache).catch(error=>{console.error('Homepage popular posts:',error);return null;}),
]);
---
<BaseLayout description="ErpanOmer，前端技术官。分享前端工程、Shopify、Cloudflare 与 AI 实践，用文章、开源项目和产品记录持续构建的过程。">
    <div class="site-container"><Hero /></div>
    <div class="section-divider"><div class="site-container"><LatestPosts latest={latestResult} popular={popularResult} /></div></div>
    <div class="section-divider"><div class="site-container"><Achievements socialStats={socialStats} websiteStats={latestResult?.meta ?? null} siteVisits={Astro.locals.viewCount ?? null} /></div></div>
    <div class="section-divider" id="selected-projects"><div class="site-container"><Projects /></div></div>
    <section class="site-container contact-section" aria-labelledby="contact-title"><div><p class="eyebrow">LET'S CONNECT</p><h2 id="contact-title">好的想法，值得一起聊聊。</h2><p>关于技术实践、产品构建，或一篇让你产生共鸣的文章。</p></div><div class="contact-links"><a class="button-primary" href="mailto:erpanomer@gmail.com">给我写邮件 ↗</a><a class="text-action" href="https://github.com/ErpanOmer" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a class="text-action" href="/rss.xml">RSS 订阅 ↗</a></div></section>
</BaseLayout>
