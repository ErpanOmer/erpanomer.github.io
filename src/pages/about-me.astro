---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPlatformGrid from "@/components/ContentPlatformGrid.astro";
import Giscus from "@/components/Giscus.astro";
import {
    fetchSocialStats,
    formatCompactCount,
    formatExactCount,
} from "@/lib/social-stats";

const socialStats = await fetchSocialStats({
    transport: import.meta.env.PROD ? "service" : "public",
    serviceBinding: import.meta.env.PROD
        ? Astro.locals.runtime?.env.GET_FANS_WORKER
        : null,
});
const hasSocialStats = socialStats.status !== "unavailable";

const proofStats = [
    {
        value: "10+",
        exact: "十余年 Web 工程经验",
        label: "年工程经验",
    },
    {
        value: hasSocialStats
            ? formatCompactCount(socialStats.totals.view_count)
            : "—",
        exact: hasSocialStats
            ? formatExactCount(socialStats.totals.view_count)
            : "数据暂时不可用",
        label: "全网阅读",
    },
    {
        value: hasSocialStats
            ? formatCompactCount(socialStats.totals.article_count)
            : "—",
        exact: hasSocialStats
            ? formatExactCount(socialStats.totals.article_count)
            : "数据暂时不可用",
        label: "技术文章",
    },
    {
        value: hasSocialStats
            ? formatCompactCount(socialStats.totals.follower_count)
            : "—",
        exact: hasSocialStats
            ? formatExactCount(socialStats.totals.follower_count)
            : "数据暂时不可用",
        label: "跨平台粉丝",
    },
];

const expertise = [
    {
        index: "01",
        title: "复杂前端架构",
        description:
            "面向大型 Web 应用设计可演进的 React / Vue / TypeScript 架构，兼顾性能、研发效率与长期维护成本。",
        tags: ["React", "Vue", "TypeScript", "SSR", "Design System"],
    },
    {
        index: "02",
        title: "全栈与边缘系统",
        description:
            "使用 Node.js、Cloudflare Workers 与 D1 构建高性能服务，完成从界面到服务端的完整交付。",
        tags: ["Node.js", "Cloudflare", "Workers", "D1", "API"],
    },
    {
        index: "03",
        title: "跨平台桌面应用",
        description:
            "覆盖 Electron 应用架构、原生能力集成、自动更新、CI/CD 与多平台发布链路。",
        tags: ["Electron", "Desktop", "Auto Update", "CI/CD"],
    },
    {
        index: "04",
        title: "Shopify 商业交付",
        description:
            "提供主题、应用和 Headless 定制能力，让技术方案直接服务于体验、转化与业务增长。",
        tags: ["Shopify", "Liquid", "Hydrogen", "Oxygen", "Commerce"],
    },
];
---

<BaseLayout
    title="关于我"
    description="ErpanOmer，资深 Web 前端专家，专注复杂前端架构、Node.js、Electron、Shopify 与 Cloudflare 边缘系统。"
>
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 sm:py-16 lg:py-20">
        <section class="relative overflow-hidden border-b border-gh-border pb-12 sm:pb-14">
            <div class="pointer-events-none absolute -right-24 -top-28 h-72 w-72 rounded-full bg-indigo-500/[0.08] blur-3xl"></div>
            <div class="relative grid items-center gap-8 sm:grid-cols-[auto_1fr] sm:gap-10 lg:gap-12">
                <div class="mx-auto sm:mx-0">
                    <div class="group relative h-32 w-32 sm:h-36 sm:w-36">
                        <div class="absolute -inset-2 rounded-full bg-gradient-to-br from-indigo-500/35 to-purple-500/20 opacity-70 blur-lg transition-opacity duration-300 group-hover:opacity-100"></div>
                        <img
                            src="https://res.cloudinary.com/dkh81cvyt/image/upload/c_fill,w_320,h_320/f_auto/q_auto/me_kknemi"
                            width="320"
                            height="320"
                            class="relative h-full w-full rounded-full border-2 border-gh-border object-cover transition-colors duration-300 group-hover:border-indigo-400"
                            alt="ErpanOmer"
                        />
                        <span
                            class="absolute bottom-2 right-2 h-4 w-4 rounded-full border-[3px] border-gh-bg bg-emerald-400"
                            aria-label="在线"
                        ></span>
                    </div>
                </div>

                <div class="text-center sm:text-left">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-indigo-400">
                        ErpanOmer · Frontend Expert
                    </p>
                    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                        资深前端专家
                    </h1>
                    <p class="mt-2 text-lg font-semibold text-gh-text sm:text-xl">
                        专注复杂系统的架构与交付
                    </p>
                    <p class="mt-4 max-w-3xl text-sm leading-7 text-gh-muted sm:text-base">
                        十余年 Web 工程经验，长期实践前端架构、Node.js 服务、Electron
                        桌面应用、Shopify 商业项目与 Cloudflare 边缘系统。擅长把复杂需求收敛为稳定、清晰、可持续演进的产品。
                    </p>

                    <div class="mt-5 flex flex-wrap justify-center gap-2 sm:justify-start">
                        {["React / Vue", "TypeScript", "Node.js", "Electron", "Shopify", "Cloudflare"].map((skill) => (
                            <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-gh-text">
                                {skill}
                            </span>
                        ))}
                    </div>

                    <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:justify-start">
                        <a
                            href="https://github.com/ErpanOmer"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-white px-5 text-sm font-bold text-gh-bg transition-all hover:-translate-y-0.5 hover:bg-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gh-bg"
                        >
                            GitHub <span aria-hidden="true">↗</span>
                        </a>
                        <a
                            href="mailto:erpanomer@gmail.com"
                            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-gh-border bg-gh-surface px-5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:border-indigo-400/50 hover:bg-white/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gh-bg"
                        >
                            联系我
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <dl class="mt-6 grid grid-cols-2 overflow-hidden rounded-xl border border-gh-border bg-gh-surface sm:grid-cols-4">
            {
                proofStats.map((stat) => (
                    <div class="border-b border-r border-gh-border px-5 py-5 even:border-r-0 [&:nth-last-child(-n+2)]:border-b-0 sm:border-b-0 sm:px-6 sm:py-6 sm:[&:nth-child(2)]:border-r sm:[&:last-child]:border-r-0">
                        <dd
                            class="text-2xl font-extrabold tracking-tight tabular-nums text-white sm:text-3xl"
                            title={stat.exact}
                            aria-label={`${stat.label}：${stat.exact}`}
                        >
                            {stat.value}
                        </dd>
                        <dt class="mt-1.5 text-xs font-semibold text-gh-muted sm:text-sm">
                            {stat.label}
                        </dt>
                    </div>
                ))
            }
        </dl>

        <section class="py-16 sm:py-20" aria-labelledby="expertise-title">
            <div class="mb-7 sm:flex sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-indigo-400">
                        Core Expertise
                    </p>
                    <h2
                        id="expertise-title"
                        class="mt-1 text-2xl font-bold tracking-tight text-white sm:text-3xl"
                    >
                        核心能力
                    </h2>
                </div>
                <p class="mt-3 max-w-xl text-sm leading-6 text-gh-muted sm:mt-0 sm:text-right">
                    从浏览器到服务端，从桌面软件到商业独立站。
                </p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                {
                    expertise.map((item) => (
                        <div class="group relative">
                            <div class="absolute -inset-0.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 opacity-0 blur transition duration-500 group-hover:opacity-15"></div>
                            <article class="relative h-full rounded-xl border border-gh-border bg-gh-surface p-5 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:border-gh-muted sm:p-6">
                                <div class="flex items-center justify-between">
                                    <span class="font-mono text-xs font-bold text-indigo-400">
                                        {item.index}
                                    </span>
                                    <span class="h-px w-10 bg-gradient-to-r from-indigo-500/70 to-transparent"></span>
                                </div>
                                <h3 class="mt-4 text-xl font-bold text-white">
                                    {item.title}
                                </h3>
                                <p class="mt-2 text-sm leading-7 text-gh-muted">
                                    {item.description}
                                </p>
                                <div class="mt-4 flex flex-wrap gap-2">
                                    {item.tags.map((tag) => (
                                        <span class="rounded-md bg-white/[0.05] px-2.5 py-1 text-[11px] font-medium text-gh-text">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </article>
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="border-t border-gh-border py-16 sm:py-20" aria-labelledby="platforms-title">
            <div class="mb-7 sm:flex sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-indigo-400">
                        Publishing Network
                    </p>
                    <h2
                        id="platforms-title"
                        class="mt-1 text-2xl font-bold tracking-tight text-white sm:text-3xl"
                    >
                        我的内容矩阵
                    </h2>
                </div>
                <p class="mt-3 max-w-xl text-sm leading-6 text-gh-muted sm:mt-0 sm:text-right">
                    跨平台持续创作与技术分享。
                </p>
            </div>

            <ContentPlatformGrid socialStats={socialStats} />
        </section>

        <section class="flex flex-col gap-5 rounded-xl border border-gh-border bg-gh-surface p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
            <div>
                <h2 class="text-xl font-bold text-white sm:text-2xl">合作与交流</h2>
                <p class="mt-2 text-sm leading-6 text-gh-muted">
                    大型前端、Electron、Shopify 或 Cloudflare 边缘架构相关项目，欢迎直接联系。
                </p>
            </div>
            <a
                href="mailto:erpanomer@gmail.com"
                class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-xl bg-indigo-500 px-5 text-sm font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-indigo-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300 focus-visible:ring-offset-2 focus-visible:ring-offset-gh-bg"
            >
                erpanomer@gmail.com
            </a>
        </section>

        <section class="pt-16 sm:pt-20" aria-labelledby="comments-title">
            <div class="text-center">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-indigo-400">
                    Discussion
                </p>
                <h2
                    id="comments-title"
                    class="mt-1 text-2xl font-bold tracking-tight text-white sm:text-3xl"
                >
                    留言与交流
                </h2>
            </div>
            <div class="mt-7 rounded-xl border border-gh-border bg-gh-surface/40 p-4 sm:p-6">
                <Giscus />
            </div>
        </section>
    </div>
</BaseLayout>
