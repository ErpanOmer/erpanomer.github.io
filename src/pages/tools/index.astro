---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
const tools = [
    { title:'Device Fingerprint', name:'设备指纹生成器', description:'在浏览器中生成设备标识，查看 Canvas、Audio 与浏览器特征的构成。', code:'DF', href:'/tools/device-fingerprint' },
    { title:'Turbo Mail Sender', name:'邮件群发工作台', description:'配置邮件服务、编辑内容与管理发送队列。需要配合独立邮件后端服务使用。', code:'TM', href:'/tools/turbo-mail-sender' },
];
---
<BaseLayout title="工具集合" description="ErpanOmer 的开发工具集合：设备指纹生成器、邮件群发工作台。">
    <div class="site-container page-shell"><PageIntro eyebrow="ERPANOMER / TOOLS" title="让日常工作，轻一点。" description="从实际需求中做出来的小工具。少一些重复操作，多一些专注的时间。" />
        <div class="tools-grid">{tools.map(tool=><a href={tool.href} class="tool-link-card"><div class="tool-card-top"><span class="tool-monogram">{tool.code}</span><span class="eyebrow">可使用 ↗</span></div><p class="tool-english-name">{tool.title}</p><h2>{tool.name}</h2><p>{tool.description}</p><span class="text-action tool-entry">打开工具 →</span></a>)}</div>
    </div>
</BaseLayout>
