---
import ProjectGrid from '@/components/ProjectGrid.astro';
---

<div class="section-space">
    <!-- Section Header -->
    <div class="mb-10">
        <p class="text-sm font-medium text-indigo-600 dark:text-indigo-400 uppercase tracking-widest mb-3">Portfolio</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-zinc-900 dark:text-white">精选项目</h2>
        <p class="text-zinc-500 dark:text-zinc-400 mt-4 max-w-2xl">
            从工程实践到可用产品，把想法变成真实的作品。
        </p>
    </div>

    <div class="capability-strip" aria-label="工程能力">
        <div><span class="eyebrow">BUILD</span><h3>产品与交互</h3><p>Web 应用、交互体验、Shopify 独立站</p></div>
        <div><span class="eyebrow">SHIP</span><h3>工程与部署</h3><p>TypeScript、Cloudflare 与边缘服务</p></div>
        <div><span class="eyebrow">SHARE</span><h3>知识与工具</h3><p>技术写作、学习笔记、开源实践</p></div>
    </div>
    <ProjectGrid />

    <!-- View All Link -->
    <div class="text-center mt-12">
        <a 
            href="/projects"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-zinc-100 dark:bg-zinc-900 text-zinc-900 dark:text-white font-medium border border-zinc-200 dark:border-zinc-800 hover:border-indigo-500/50 transition-all"
        >
            <span>查看全部项目</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
        </a>
    </div>
</div>
