---
import PlatformCard from '@/components/PlatformCard.astro';
import { SOCIAL_PLATFORM_CONFIGS } from '@/data/social-platforms';
import { findPlatformStats, sortSocialPlatformsByViews, type SocialStatsResult } from '@/lib/social-stats';
import type { CatalogMeta } from '@/lib/public-posts';
import type { PlatformCardConfig, PlatformCardStats, PlatformCardMetric } from '@/lib/platform-card';
import me from '@/images/me.jpg';
interface Props { socialStats: SocialStatsResult; websiteStats?: CatalogMeta | null; siteVisits?: number | null; }
const { socialStats, websiteStats, siteVisits } = Astro.props;
const sorted = sortSocialPlatformsByViews(SOCIAL_PLATFORM_CONFIGS,socialStats);
const platformConfigs = [...sorted.filter(platform=>platform.id==='wechat'),...sorted.filter(platform=>platform.id!=='wechat')];
const cards: Array<{ platform:PlatformCardConfig; stats:PlatformCardStats|null }> = platformConfigs.map(platform=>{
    const raw = findPlatformStats(socialStats,platform.id);
    return { platform, stats:raw ? { stats:{...raw.stats,site_visits:0},availableMetrics:raw.availableMetrics } : null };
});
if (websiteStats !== undefined) {
    const availableMetrics: PlatformCardMetric[] = [];
    const values = {article_count:websiteStats?.total,view_count:websiteStats?.views,like_count:websiteStats?.likes,site_visits:siteVisits};
    for (const [metric,value] of Object.entries(values)) {
        if (typeof value==='number') availableMetrics.push(metric as PlatformCardMetric);
    }
    cards.unshift({
        platform:{ id:'website',name:'本站 · ErpanOmer',shortName:'Website',displayHandle:'erpanomer.nurverse.com',
            profileUrl:'/blog',allowedDomains:['erpanomer.nurverse.com'],logo:me,brandColor:'#818cf8',linkEnabled:true,
            internal:true,handlePrefix:'',emptyTitle:'本站统计暂不可用',emptyDescription:'文章与历史内容仍可访问' },
        stats:{stats:{article_count:websiteStats?.total??0,view_count:websiteStats?.views??0,like_count:websiteStats?.likes??0,
            site_visits:siteVisits??0,follower_count:0,favorite_count:0},availableMetrics},
    });
}
---
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map(card=><PlatformCard platform={card.platform} stats={card.stats} unavailable={socialStats.status==='unavailable'} />)}
</div>
