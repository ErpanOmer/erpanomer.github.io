---
import type { CatalogPage } from '@/lib/public-posts';
import { formatPostDate } from '@/lib/posts';
import { getPostCoverUrl } from '@/lib/post-card';
interface Props { latest: CatalogPage | null; popular: CatalogPage | null; }
const { latest, popular } = Astro.props;
const latestSlugs = new Set(latest?.items.map(post=>post.slug));
const popularPosts = popular?.items.filter(post=>!latestSlugs.has(post.slug)).slice(0,3) || [];
---
<section class="home-writing quiet-writing section-space" aria-labelledby="writing-title">
    <div class="section-heading"><div><p class="eyebrow">WRITING</p><h2 id="writing-title">最近的记录</h2><p>技术实践，也有工作与成长中的思考。</p></div><a href="/blog" class="text-action">全部文章 ↗</a></div>
    {latest?.source === 'static' && <p class="catalog-notice">当前仅展示静态文章，数据库统计暂不可用。</p>}
    {latest ? <div class="writing-previews">{latest.items.slice(0,6).map(post=>{
        const cover = getPostCoverUrl(post.cover);
        return <article class:list={['writing-preview', { 'writing-preview-text': !cover }]}>
            <a class="writing-card-link" href={`/blog/${post.slug}`}>
                {cover && <div class="writing-cover"><img src={cover} alt="" width="640" height="360" loading="lazy" decoding="async" /></div>}
                <div class="writing-preview-content">
                    <div class="writing-meta"><time datetime={post.pubDate}>{formatPostDate(post.pubDate,'sv-SE')}</time><span aria-hidden="true">↗</span></div>
                    <h3 title={post.title}>{post.title}</h3>
                    <p>{post.description}</p>
                </div>
            </a>
        </article>;
    })}</div> : <p class="catalog-notice">文章暂时加载失败，<a href="/blog">前往文章列表重试 →</a></p>}
    {latest && !latest.items.length && <p class="catalog-notice">新的思考正在路上，敬请期待。</p>}
    {popularPosts.length > 0 && <div class="quiet-popular"><div class="subsection-heading"><h3>大家也在读</h3><a class="text-action" href="/blog?sort=views">更多热门 ↗</a></div><ol>{popularPosts.map(post=>{
        const cover = getPostCoverUrl(post.cover);
        return <li>
            {cover && <a class="popular-cover" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true"><img src={cover} alt="" width="240" height="135" loading="lazy" decoding="async" /></a>}
            <div><a href={`/blog/${post.slug}`}>{post.title}</a><span>{post.views === null ? '—' : post.views.toLocaleString('zh-CN')} 阅读</span></div>
        </li>;
    })}</ol></div>}
</section>
