---
import ContentPlatformGrid from "@/components/ContentPlatformGrid.astro";
import { combineInfluenceStats } from '@/lib/influence';
import type { CatalogMeta } from '@/lib/public-posts';
import {
    formatCompactCount,
    formatExactCount,
    type SocialMetric,
} from "@/lib/social-stats";

interface Props { socialStats: import('@/lib/social-stats').SocialStatsResult; websiteStats: CatalogMeta | null; siteVisits: number | null; }
const { socialStats, websiteStats, siteVisits } = Astro.props;
const combinedStats = combineInfluenceStats(socialStats, websiteStats);

const metricCards: Array<{ metric: SocialMetric; label: string }> = [
    { metric: "view_count", label: "全网阅读" },
    { metric: "follower_count", label: "全网粉丝" },
    { metric: "article_count", label: "累计发布" },
    { metric: "like_count", label: "收获点赞" },
    { metric: "favorite_count", label: "内容收藏" },
];
---

<section
    id="social-achievements"
    class="section-space"
    aria-labelledby="social-achievements-title"
>
    <div class="mb-8 sm:mb-10">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.22em] text-indigo-400 sm:text-sm">
            Achievements
        </p>
        <h2
            id="social-achievements-title"
            class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
        >
            成就与影响力
        </h2>
        <p class="mt-3 max-w-xl text-sm text-gh-muted sm:text-base">
            本站与各内容平台的共同积累。阅读、点赞与发布篇次直接累加，含跨平台分发。
        </p>
    </div>

    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-5">
        {
            metricCards.map((card, index) => {
                const exactValue = combinedStats.totals[card.metric];
                const isUnavailable = !combinedStats.coverage[card.metric];
                const compactValue = isUnavailable
                    ? "—"
                    : formatCompactCount(exactValue);
                const accessibleValue = isUnavailable
                    ? `${card.label}暂时不可用`
                    : `${card.label}：${formatExactCount(exactValue)}`;

                return (
                    <div
                        class:list={[
                            "group relative",
                            index === metricCards.length - 1 &&
                                "col-span-2 sm:col-span-1",
                        ]}
                    >
                        <div class="absolute -inset-0.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 opacity-0 blur transition duration-500 group-hover:opacity-20 group-focus-within:opacity-20" />
                        <div class="relative rounded-xl border border-gh-border bg-gh-surface px-4 py-5 text-center transition-all duration-300 group-hover:-translate-y-0.5 group-hover:border-gh-muted sm:px-5 sm:py-6">
                            <div class="mx-auto mb-3 h-1.5 w-8 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 opacity-70 transition-all duration-300 group-hover:w-12 group-hover:opacity-100" />
                            <dt class="text-sm font-semibold text-gh-text sm:text-base">
                                {card.label}
                            </dt>
                            <dd
                                data-influence-metric={card.metric}
                                data-exact-value={isUnavailable ? undefined : exactValue}
                                class="mt-2 text-2xl font-extrabold tracking-tight tabular-nums text-white sm:text-3xl lg:text-[1.85rem] lg:leading-tight"
                                title={accessibleValue}
                                aria-label={accessibleValue}
                            >
                                {compactValue}
                            </dd>
                        </div>
                    </div>
                );
            })
        }
    </dl>
    {socialStats.status === 'unavailable' && <p class="catalog-notice">外部平台数据暂不可用，当前汇总仅包含本站已获得的数据。</p>}
    {!websiteStats && <p class="catalog-notice">本站文章统计暂不可用，已保留各平台的现有统计。</p>}

    <div class="mb-5 mt-12 sm:mt-14">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-indigo-400">
            Publishing Network
        </p>
        <h3 class="mt-1 text-2xl font-bold tracking-tight text-white sm:text-3xl">
            我的内容矩阵
        </h3>
    </div>

    <ContentPlatformGrid socialStats={socialStats} websiteStats={websiteStats} siteVisits={siteVisits} />
</section>
