---
import type { ImageMetadata } from "astro";

interface Props {
    logo: ImageMetadata | null;
    logoText?: string;
    brandColor: string;
    compact?: boolean;
    preserveOriginalColor?: boolean;
    alwaysColor?: boolean;
    fillContainer?: boolean;
    enlargeContent?: boolean;
}

const {
    logo,
    logoText,
    brandColor,
    compact = false,
    preserveOriginalColor = false,
    alwaysColor = false,
    fillContainer = false,
    enlargeContent = false,
} = Astro.props;
---

<span
    class:list={[
        "social-platform-logo flex shrink-0 items-center justify-center rounded-xl bg-gh-bg transition-all duration-300",
        compact ? "h-10 w-10" : "h-10 w-10",
        fillContainer
            ? ""
            : enlargeContent
              ? "p-1.5"
              : "p-2.5",
        alwaysColor && "social-platform-logo--color",
    ]}
    style={`--platform-color: ${brandColor};`}
    aria-hidden="true"
>
    {
        logo && preserveOriginalColor ? (
            <img
                src={logo.src}
                alt=""
                width="32"
                height="32"
                loading="lazy"
                class:list={[
                    "social-platform-logo__image block h-full w-full",
                    fillContainer ? "object-cover" : "object-contain",
                ]}
            />
        ) : logo ? (
            <span
                class="social-platform-logo__mark block h-full w-full"
                style={`--platform-logo: url("${logo.src}");`}
            />
        ) : (
            <span class="social-platform-logo__text text-[10px] font-black">
                {logoText}
            </span>
        )
    }
</span>

<style>
    .social-platform-logo__mark {
        background-color: #c9d1d9;
        mask-image: var(--platform-logo);
        mask-position: center;
        mask-repeat: no-repeat;
        mask-size: contain;
        -webkit-mask-image: var(--platform-logo);
        -webkit-mask-position: center;
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-size: contain;
        transition:
            background-color 300ms ease,
            filter 300ms ease,
            transform 300ms ease;
    }

    .social-platform-logo__text {
        color: #c9d1d9;
        transition: color 300ms ease;
    }

    .social-platform-logo__image {
        filter: grayscale(1);
        opacity: 0.78;
        transition:
            filter 300ms ease,
            opacity 300ms ease,
            transform 300ms ease;
    }

    .social-platform-logo--color {
        background-color: color-mix(in srgb, var(--platform-color) 7%, #0d1117);
    }

    .social-platform-logo--color .social-platform-logo__mark {
        background-color: var(--platform-color);
    }

    .social-platform-logo--color .social-platform-logo__text {
        color: var(--platform-color);
    }

    .social-platform-logo--color .social-platform-logo__image {
        filter: grayscale(0);
        opacity: 1;
    }

    :global(.group:hover) .social-platform-logo,
    :global(.group:focus-within) .social-platform-logo {
        /* box-shadow: 0 0 20px color-mix(in srgb, var(--platform-color) 18%, transparent); */
    }

    :global(.group:hover) .social-platform-logo__mark,
    :global(.group:focus-within) .social-platform-logo__mark {
        background-color: var(--platform-color);
        filter: drop-shadow(0 0 7px color-mix(in srgb, var(--platform-color) 45%, transparent));
        transform: scale(1.04);
    }

    :global(.group:hover) .social-platform-logo__text,
    :global(.group:focus-within) .social-platform-logo__text {
        color: var(--platform-color);
    }

    :global(.group:hover) .social-platform-logo__image,
    :global(.group:focus-within) .social-platform-logo__image {
        filter: grayscale(0);
        opacity: 1;
        transform: scale(1.04);
    }

    @media (prefers-reduced-motion: reduce) {
        .social-platform-logo,
        .social-platform-logo__mark,
        .social-platform-logo__text,
        .social-platform-logo__image {
            transition: none;
        }
    }
</style>
